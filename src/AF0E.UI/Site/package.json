{
  "name": "af0e-site",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng s --proxy-config proxy.conf.js",
    "startall": "ng s --host 0.0.0.0 --ssl --proxy-config proxy.conf.js",
    "build": "ng build",
    "build:test": "npm run test && npm run build",
    "build:prod": "npm run test && ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --no-watch",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@12.2.0",
  "dependencies": {
    "@angular/common": "22.1.8",
    "@angular/compiler": "22.1.8",
    "@angular/core": "22.1.8",
    "@angular/forms": "22.1.8",
    "@angular/platform-browser": "22.1.8",
    "@angular/router": "22.1.8",
    "@microsoft/signalr": "10.0.11",
    "@auth0/auth0-angular": "2.13.0",
    "@primeuix/themes": "3.0.1",
    "mapbox-gl": "3.32.0",
    "material-design-icons": "3.0.1",
    "primeicons": "8.0.2",
    "primeng": "22.1.2",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "@turf/helpers": "7.4.0",
    "@turf/great-circle": "7.4.0"
  },
  "devDependencies": {
    "@angular/build": "22.1.8",
    "@angular/cli": "22.1.8",
    "@angular/compiler-cli": "22.1.8",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/ui": "4.1.11",
    "agentkeepalive": "4.6.0",
    "jsdom": "30.1.2",
    "typescript": "~6.0.2",
    "vitest": "4.1.11"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "lmdb@3.5.4": true,
    "browser-tabs-lock@1.3.0": true,
    "msgpackr-extract@3.0.4": true,
    "@parcel/watcher@2.6.0": true
  }
}
